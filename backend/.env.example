SECRET_KEY=django-insecure-change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC

# Database — leave as sqlite for local dev, switch to postgres for production
DB_ENGINE=sqlite
DB_NAME=ems_db
DB_USER=ems_user
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Frontend origin(s) allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

